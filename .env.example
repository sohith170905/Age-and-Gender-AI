# Copy to .env for local overrides. Never commit the real .env.
AGE_GENDER_APP_NAME=Age & Gender AI
AGE_GENDER_APP_VERSION=2.0.0
AGE_GENDER_MODEL=agevision_onnx
AGE_GENDER_MAX_UPLOAD_BYTES=16777216
AGE_GENDER_MAX_IMAGE_PIXELS=40000000
AGE_GENDER_MAX_FACES=80
AGE_GENDER_MAX_BATCH_IMAGES=5
AGE_GENDER_UNCERTAIN_CONFIDENCE=55
AGE_CONFIDENCE_UNCERTAIN_BELOW=10
AGE_GENDER_BLUR_THRESHOLD=18
AGE_GENDER_DARK_THRESHOLD=38
AGE_GENDER_BRIGHT_THRESHOLD=225
AGE_GENDER_RETENTION_DAYS=0
DATABASE_URL=
AGE_GENDER_API_KEY=replace-with-a-long-random-key
AGE_GENDER_API_RATE_LIMIT=60
AGE_GENDER_CAMERA_FRAME_INTERVAL=5
AGE_GENDER_CAMERA_MAX_WIDTH=640
AGE_GENDER_CAMERA_MAX_HEIGHT=480
AGE_GENDER_CAMERA_STUN_URL=
